{
  "manifest_version": 3,
  "name": "Universal Web AI - VS Code Agent Bridge",
  "version": "2.0.0",
  "description": "Universal Bi-directional Bridge connecting Web LLM Chat UIs (Gemini, ChatGPT, Claude, DeepSeek, OpenWebUI & Custom Enterprise LLMs) with VS Code Agent",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "options.html",
    "default_title": "Universal Web AI Agent Settings"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
